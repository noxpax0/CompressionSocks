<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CompressionGarmentOrder</AssemblyName>
    <RootNamespace>CompressionGarmentOrder</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Mercury</Product>
    <Description>Offline compression garment order application</Description>
    <ApplicationIcon>Assets\mercury.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Mercury.Tests\**\*.cs" />
    <None Remove="Mercury.Tests\**\*" />
  </ItemGroup>
  <!-- Source web app: embedded at build time, never unpacked by this application. -->
  <ItemGroup>
    <EmbeddedResource Include="Web\index.html" LogicalName="Web.index.html" />
    <EmbeddedResource Include="Web\styles.css" LogicalName="Web.styles.css" />
    <EmbeddedResource Include="Web\script.js" LogicalName="Web.script.js" />
    <EmbeddedResource Include="Web\assets\**\*" LogicalName="Web.assets.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\mercury-logo.png" LogicalName="AppAssets.mercury-logo.png" />
    <EmbeddedResource Include="Assets\mercury-logo-cropped.png" LogicalName="AppAssets.mercury-logo-cropped.png" />
    <EmbeddedResource Include="Assets\mercury.ico" LogicalName="AppAssets.mercury.ico" />
  </ItemGroup>
  <Target Name="RemoveWebView2DocumentationFromPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)Microsoft.Web.WebView2.Core.xml;$(PublishDir)Microsoft.Web.WebView2.WinForms.xml;$(PublishDir)Microsoft.Web.WebView2.Wpf.xml" />
  </Target>
  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Reference.Filename)').Equals('Microsoft.Web.WebView2.Wpf'))" />
    </ItemGroup>
  </Target>
</Project>
